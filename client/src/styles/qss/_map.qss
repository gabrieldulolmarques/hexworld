/* Map editor — scale aligned with _base.qss / home / auth */

QWidget#mapScreen {
    background-color: #09090b;
    color: #e4e4e7;
}

QWidget#mapTopBar {
    background-color: #18181b;
    border: 1px solid #3f3f46;
    border-radius: 12px;
}

QWidget#mapTopBar QLabel#subtitle {
    font-size: 15px;
}

QWidget#mapTopBar QLabel#title {
    color: #e4e4e7;
    font-size: 21px;
    font-weight: 700;
    padding: 0;
    min-width: 0;
}

QWidget#mapWorkspace,
QWidget#mapCanvasArea {
    background-color: #09090b;
}

QWidget#mapStructureArea,
QWidget#paletteGrid {
    background-color: #18181b;
}

QWidget#mapInspectorMembers {
    background-color: transparent;
}

QLabel#onlinePanelTitle {
    color: #e4e4e7;
    font-size: 17px;
    font-weight: 700;
}

QLabel#onlinePanelRatio {
    color: #e4e4e7;
    font-size: 17px;
    font-weight: 700;
    padding-left: 4px;
}

QLabel#onlinePanelUser {
    color: #d4d4d8;
    font-size: 16px;
    font-weight: 500;
}

QPushButton#onlinePanelCollapse {
    background: transparent;
    border: none;
    padding: 0;
    min-width: 0;
}

QPushButton#onlinePanelCollapse:hover {
    background: #27272a;
    border-radius: 8px;
}

QWidget#mapMinimap {
    background-color: #18181b;
    border: 1px solid #3f3f46;
    border-radius: 12px;
}

QWidget#mapSelectPanel,
QWidget#mapBottomBar,
QWidget#mapPalette,
QWidget#mapToolStrip,
QWidget#mapRoadPanel {
    background-color: #18181b;
    border: 1px solid #3f3f46;
    border-radius: 12px;
}

QWidget#mapBottomBar {
    max-width: 400px;
}

QWidget#mapSelectPanel QLabel#title {
    font-size: 20px;
    font-weight: 600;
    qproperty-alignment: AlignCenter;
}

QTextBrowser#tileInfoBrowser {
    background-color: transparent;
    border: none;
    color: #d4d4d8;
    font-size: 14px;
    selection-background-color: __GREEN_SELECTION_BG__;
}

QTextBrowser#tileInfoBrowser QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    margin: 2px 2px 2px 0;
}

QTextBrowser#tileInfoBrowser QScrollBar::handle:vertical {
    background-color: #3f3f46;
    border-radius: 4px;
    min-height: 24px;
}

QTextBrowser#tileInfoBrowser QScrollBar::handle:vertical:hover {
    background-color: #52525c;
}

QTextBrowser#tileInfoBrowser QScrollBar::add-line:vertical,
QTextBrowser#tileInfoBrowser QScrollBar::add-page:vertical,
QTextBrowser#tileInfoBrowser QScrollBar::sub-line:vertical,
QTextBrowser#tileInfoBrowser QScrollBar::sub-page:vertical {
    height: 0;
    background: transparent;
}

QWidget#hexCanvas {
    background-color: #09090b;
}

QWidget#biomeTabStrip {
    background-color: #141416;
    border: 1px solid #3f3f46;
    border-radius: 10px;
}

QScrollArea#inspectorScroll {
    background: transparent;
    border: none;
}

QWidget#inspectorBody {
    background: transparent;
}

QFrame#inspectorSection,
QFrame#inspectorConnectionsSection {
    background-color: #141416;
    border: 1px solid #3f3f46;
    border-radius: 10px;
}

QFrame#inspectorStructureHeader {
    background-color: #141416;
    border: 1px solid #3f3f46;
    border-radius: 10px;
}

QLabel#inspectorStructureName {
    color: #f4f4f5;
    font-size: 16px;
    font-weight: 600;
}

QLabel#inspectorStructureBiome {
    color: #a1a1aa;
    font-size: 13px;
}

QFrame#inspectorFooter,
QFrame#inspectorTileRecord {
    background-color: #1a1a1e;
    border: 1px solid #3f3f46;
    border-radius: 10px;
}

QLabel#inspectorFooterNote {
    color: #71717a;
    font-size: 12px;
    padding: 6px 4px;
}

QLabel#inspectorDescMeta {
    color: #a1a1aa;
    font-size: 12px;
}

QFrame#inspectorDescSection {
    background-color: #141416;
    border: 1px solid #3f3f46;
    border-radius: 10px;
}

QWidget#inspectorDescHost {
    background: transparent;
}

QLabel#inspectorValue {
    color: #e4e4e7;
    font-size: 14px;
}

QLabel#inspectorTileRecordTitle {
    color: #a1a1aa;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.4px;
}

QLabel#inspectorTileRecordLine {
    color: #d4d4d8;
    font-size: 13px;
}

QTextBrowser#inspectorDescBrowser {
    background-color: transparent;
    border: none;
    color: #ffffff;
    selection-background-color: __GREEN_SELECTION_BG__;
    selection-color: #ffffff;
}

QTextBrowser#inspectorDescBrowser QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    margin: 2px 0;
}

QTextBrowser#inspectorDescBrowser QScrollBar::handle:vertical {
    background-color: #3f3f46;
    border-radius: 4px;
    min-height: 24px;
}

QLabel#inspectorMetaLine {
    color: #a1a1aa;
    font-size: 12px;
    padding-top: 2px;
}

QLabel#inspectorBanner {
    color: #a1a1aa;
    font-size: 13px;
    padding: 10px 8px;
}

QLabel#inspectorBanner[level="error"] {
    color: __RED_TEXT__;
}

QLabel#inspectorBanner[level="info"] {
    color: #9f9fa9;
}

QWidget#inspectorPreview {
    background: transparent;
    border: none;
}

QScrollArea#inspectorScroll QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 2px 0;
}

QScrollArea#inspectorScroll QScrollBar::handle:vertical {
    background-color: #3f3f46;
    border-radius: 4px;
    min-height: 24px;
}

QScrollArea#inspectorScroll QScrollBar::add-line:vertical,
QScrollArea#inspectorScroll QScrollBar::sub-line:vertical {
    height: 0;
}

QWidget#mapSelectPanel QLabel#fieldLabel,
QWidget#mapBottomBar QLabel#fieldLabel,
QWidget#mapPalette QLabel#fieldLabel,
QWidget#mapRoadPanel QLabel#fieldLabel {
    color: #9f9fa9;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.6px;
}

QToolButton#biomeTab {
    background: transparent;
    border: none;
    border-radius: 8px;
    color: #71717b;
    font-size: 13px;
    font-weight: 600;
    padding: 6px 4px;
}

QToolButton#biomeTab:hover {
    color: #a1a1aa;
    background-color: #1c1c1f;
}

QToolButton#biomeTab:checked {
    background-color: __GREEN_ACTIVE_BG__;
    color: __GREEN_TINT__;
}

QWidget#tileBtn {
    background-color: #09090b;
    border: 1px solid #3f3f46;
    border-radius: 8px;
}

QWidget#tileBtn[hovered="true"] {
    background-color: #141416;
    border-color: #52525c;
}

QWidget#tileBtn[checked="true"] {
    background-color: __GREEN_ACTIVE_BG__;
    border-color: __GREEN_PRIMARY__;
}

QWidget#tileBtn QLabel {
    background: transparent;
}

QLabel#tileBtnLabel {
    color: #d4d4d8;
    font-size: 15px;
    font-weight: 700;
}

QWidget#tileBtn[checked="true"] QLabel#tileBtnLabel {
    color: __GREEN_TINT__;
}

QScrollArea#paletteScroll {
    background-color: #18181b;
    border: none;
}

QScrollArea#paletteScroll > QWidget > QWidget {
    background-color: #18181b;
}

QScrollArea#paletteScroll QScrollBar:vertical {
    background-color: #27272a;
    border-radius: 5px;
    width: 10px;
    margin: 4px 3px 4px 3px;
}

QScrollArea#paletteScroll QScrollBar::handle:vertical {
    background-color: #52525c;
    border-radius: 4px;
    min-height: 32px;
}

QScrollArea#paletteScroll QScrollBar::handle:vertical:hover {
    background-color: #71717b;
}

QScrollArea#paletteScroll QScrollBar::add-line:vertical,
QScrollArea#paletteScroll QScrollBar::add-page:vertical,
QScrollArea#paletteScroll QScrollBar::sub-line:vertical,
QScrollArea#paletteScroll QScrollBar::sub-page:vertical {
    height: 0;
    background: transparent;
}

QWidget#paletteGrid {
    background-color: #18181b;
}


QToolButton#mapToolBtn {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 0;
}

QToolButton#mapToolBtn:hover {
    background-color: __GREEN_HOVER_BG__;
    border-color: __GREEN_HOVER_BORDER__;
}

QToolButton#mapToolBtn[toolId="erase"]:hover {
    background-color: __RED_HOVER_BG__;
    border-color: __RED_HOVER_BORDER__;
}

QToolButton#mapToolBtn[active="true"] {
    background-color: __GREEN_ACTIVE_BG__;
    border-color: __GREEN_PRIMARY__;
}

QToolButton#mapToolBtn[toolId="erase"][active="true"] {
    background-color: __RED_ACTIVE_BG__;
    border-color: __RED_PRIMARY__;
}

QWidget#mapRoadPanel QLineEdit {
    background-color: #27272a;
    border: 1px solid #3f3f46;
    border-radius: 8px;
    color: #e4e4e7;
    padding: 12px 16px;
    font-size: 15px;
}

QWidget#mapRoadPanel QLineEdit:focus {
    border-color: __GREEN_PRIMARY__;
}

QWidget#mapRoadPanel QRadioButton {
    color: #d4d4d8;
    font-size: 14px;
    font-weight: 600;
    spacing: 8px;
}

QWidget#mapRoadPanel QRadioButton::indicator {
    width: 16px;
    height: 16px;
}

QWidget#mapRoadPanel QRadioButton::indicator:unchecked {
    border: 1px solid #3f3f46;
    border-radius: 8px;
    background-color: #09090b;
}

QWidget#mapRoadPanel QRadioButton::indicator:checked {
    border: 4px solid __GREEN_PRIMARY__;
    border-radius: 8px;
    background-color: __GREEN_TINT__;
}

QWidget#roadSavedRow {
    background: transparent;
}

QLabel#panelTitle {
    padding: 0 0 4px 0;
}

QWidget#descriptionEditorBackdrop {
    background-color: rgba(9, 9, 11, 0.72);
}

QWidget#exportDialogBackdrop {
    background-color: rgba(9, 9, 11, 0.72);
}

QWidget#descriptionEditorCard,
QWidget#exportDialogCard {
    background-color: #18181b;
    border: 1px solid #3f3f46;
    border-radius: 12px;
}

QLabel#descriptionEditorCoord {
    color: #9f9fa9;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.3px;
}

QTextEdit#descriptionEditorInput {
    background-color: #09090b;
    border: 1px solid #3f3f46;
    border-radius: 8px;
    color: #e4e4e7;
    padding: 12px;
    font-size: 15px;
    selection-background-color: __GREEN_SELECTION_BG__;
}

QTextEdit#descriptionEditorInput:focus {
    border-color: __GREEN_PRIMARY__;
}

QLineEdit#exportDialogPath {
    background-color: #09090b;
    border: 1px solid #3f3f46;
    border-radius: 8px;
    color: #e4e4e7;
    padding: 12px 16px;
    font-size: 15px;
    selection-background-color: __GREEN_SELECTION_BG__;
}

QLineEdit#exportDialogPath:focus {
    border-color: __GREEN_PRIMARY__;
}

QLineEdit#exportDialogPath:disabled {
    color: #71717b;
    background-color: #141416;
}

QTextEdit#descriptionEditorInput QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    margin: 2px 2px 2px 0;
}

QTextEdit#descriptionEditorInput QScrollBar::handle:vertical {
    background-color: #3f3f46;
    border-radius: 4px;
    min-height: 24px;
}

QTextEdit#descriptionEditorInput QScrollBar::handle:vertical:hover {
    background-color: #52525c;
}

QTextEdit#descriptionEditorInput QScrollBar::add-line:vertical,
QTextEdit#descriptionEditorInput QScrollBar::add-page:vertical,
QTextEdit#descriptionEditorInput QScrollBar::sub-line:vertical,
QTextEdit#descriptionEditorInput QScrollBar::sub-page:vertical {
    height: 0;
    background: transparent;
}

/* Home map list — unchanged */
QLabel#mapName {
    color: #e4e4e7;
    font-size: 17px;
    font-weight: 700;
}

QLabel#mapMeta {
    color: #71717b;
    font-size: 14px;
    font-weight: 500;
}

QLabel#mapRole {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.2px;
}

QLabel#mapRole[role="owner"] {
    color: __GREEN_TINT__;
}

QLabel#mapRole[role="editor"] {
    color: #38bdf8;
}

QLabel#mapRole[role="viewer"] {
    color: #71717b;
}

QScrollArea#membersScroll,
QScrollArea#membersScroll > QWidget > QWidget {
    background-color: transparent;
    border: none;
}

QScrollArea#membersScroll QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    margin: 2px 2px 2px 0;
}

QScrollArea#membersScroll QScrollBar::handle:vertical {
    background-color: #3f3f46;
    border-radius: 4px;
    min-height: 24px;
}

QScrollArea#membersScroll QScrollBar::handle:vertical:hover {
    background-color: #52525c;
}

QScrollArea#membersScroll QScrollBar::add-line:vertical,
QScrollArea#membersScroll QScrollBar::add-page:vertical,
QScrollArea#membersScroll QScrollBar::sub-line:vertical,
QScrollArea#membersScroll QScrollBar::sub-page:vertical {
    height: 0;
    background: transparent;
}

QScrollArea#mapScroll,
QScrollArea#mapScroll > QWidget > QWidget {
    background-color: transparent;
    border: none;
}

QScrollArea#mapScroll QScrollBar:vertical {
    background-color: transparent;
    width: 10px;
    margin: 4px 5px 4px 3px;
}

QScrollArea#mapScroll QScrollBar::handle:vertical {
    background-color: #3f3f46;
    border-radius: 4px;
    min-height: 32px;
}

QScrollArea#mapScroll QScrollBar::handle:vertical:hover {
    background-color: #52525c;
}

QScrollArea#mapScroll QScrollBar::add-line:vertical,
QScrollArea#mapScroll QScrollBar::add-page:vertical,
QScrollArea#mapScroll QScrollBar::sub-line:vertical,
QScrollArea#mapScroll QScrollBar::sub-page:vertical {
    height: 0;
    background: transparent;
}
