QLabel#mapName {
    color: #e4e4e7;
    font-size: 17px;
    font-weight: 700;
}

QLabel#mapMeta {
    color: #71717b;
    font-size: 14px;
    font-weight: 500;
}

QLabel#mapRole {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.4px;
}

QLabel#mapRole[role="owner"] {
    color: #7ccf00;
}

QLabel#mapRole[role="editor"] {
    color: #38bdf8;
}

QLabel#mapRole[role="viewer"] {
    color: #71717b;
}

QFrame#mapCard QPushButton {
    padding: 8px 16px;
    font-size: 14px;
    font-weight: 500;
    border-radius: 6px;
    min-width: 0;
}

QScrollArea#mapScroll,
QScrollArea#mapScroll > QWidget > QWidget {
    background-color: transparent;
    border: none;
}

QScrollBar:vertical {
    background-color: transparent;
    width: 6px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #3f3f46;
    border-radius: 3px;
    min-height: 32px;
}

QScrollBar::handle:vertical:hover {
    background-color: #52525c;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}
