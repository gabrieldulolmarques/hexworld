* {
    font-family: "Inter", "Segoe UI", "SF Pro Display", "Helvetica Neue", sans-serif;
}

QLabel {
    color: #e4e4e7;
    font-size: 16px;
    background-color: transparent;
}

QLabel#brand {
    color: #e4e4e7;
    font-size: 32px;
    font-weight: 700;
    letter-spacing: -0.5px;
}

QLabel#brandSmall {
    color: #e4e4e7;
    font-size: 21px;
    font-weight: 700;
    letter-spacing: -0.3px;
}

QLabel#title {
    color: #e4e4e7;
    font-size: 25px;
    font-weight: 600;
}

QLabel#subtitle {
    color: #9f9fa9;
    font-size: 15px;
    font-weight: 600;
}

QLabel#fieldLabel {
    color: #9f9fa9;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.6px;
}

QLabel#status {
    color: #9f9fa9;
    font-size: 14px;
    font-weight: 700;
    min-height: 18px;
}

QLabel[level="error"] {
    color: #e7000b;
}

QLabel[level="success"] {
    color: #497d00;
}

QLabel[level="info"] {
    color: #9f9fa9;
}

QLabel#userBadge {
    color: #9ae600;
    font-size: 14px;
    font-weight: 600;
    background-color: rgba(94, 165, 0, 0.14);
    border: 1px solid rgba(94, 165, 0, 0.38);
    border-radius: 8px;
    padding: 5px 14px;
}

/* Panels / cards: 1px #3f3f46, 12px radius */
QWidget#card,
QWidget#heroCard,
QFrame#mapCard {
    background-color: #18181b;
    border: 1px solid #3f3f46;
    border-radius: 12px;
}

QFrame#mapCard:hover {
    background-color: #1c1c20;
    border-color: #52525c;
}

QLineEdit {
    background-color: #27272a;
    color: #e4e4e7;
    border: 1px solid #3f3f46;
    border-radius: 8px;
    padding: 12px 16px;
    font-size: 15px;
    selection-background-color: #5ea500;
    selection-color: #FFFFFF;
}

QLineEdit:focus {
    border: 1px solid #5ea500;
    background-color: #27272a;
}

QLineEdit:disabled {
    color: #71717b;
    background-color: #18181b;
}

QPushButton {
    background-color: #5ea500;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 13px 22px;
    font-size: 15px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #497d00;
}

QPushButton:pressed {
    background-color: #3c6300;
}

QPushButton:disabled {
    background-color: #3f3f46;
    color: #9f9fa9;
}

QPushButton#ghost {
    background-color: transparent;
    color: #9f9fa9;
    border: 1px solid #3f3f46;
    border-radius: 8px;
    padding: 0 16px;
    font-size: 15px;
    font-weight: 600;
}

QPushButton#ghost:hover {
    background-color: #18181b;
    border-color: #52525c;
    color: #e4e4e7;
}

QPushButton#ghost:disabled {
    color: #71717b;
    border-color: #27272a;
}

QPushButton#primary {
    background-color: #5ea500;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 0 16px;
    font-size: 15px;
    font-weight: 600;
}

QPushButton#primary:hover {
    background-color: #497d00;
}

QPushButton#primary:pressed {
    background-color: #3c6300;
}

QPushButton#primary:disabled {
    background-color: #3f3f46;
    color: #9f9fa9;
}

QWidget#card QPushButton#primary,
QWidget#authScreen QPushButton#primary,
QWidget#card QPushButton#ghost {
    min-height: 46px;
    max-height: 46px;
}

QWidget#homeTopBar QPushButton#primary,
QWidget#homeTopBar QPushButton#secondary,
QWidget#homeTopBar QPushButton#danger {
    min-width: 120px;
    max-width: 120px;
    min-height: 46px;
    max-height: 46px;
    padding: 0 8px;
}

QPushButton#secondary {
    background-color: #18181b;
    color: #e4e4e7;
    border: 1px solid #3f3f46;
    border-radius: 8px;
    padding: 0 16px;
    font-size: 15px;
    font-weight: 600;
}

QPushButton#secondary:hover {
    background-color: #27272a;
    border-color: #71717b;
}

QPushButton#secondary:pressed {
    background-color: #09090b;
}

QPushButton#secondary:disabled {
    color: #71717b;
    border-color: #27272a;
    background-color: transparent;
}

QPushButton#danger {
    background-color: transparent;
    color: #f87171;
    border: 1px solid #7f1d1d;
    border-radius: 8px;
    padding: 0 16px;
    font-size: 15px;
    font-weight: 600;
}

QPushButton#danger:hover {
    background-color: rgba(239, 68, 68, 0.12);
    border-color: #ef4444;
    color: #fca5a5;
}

QPushButton#danger:pressed {
    background-color: rgba(239, 68, 68, 0.2);
}

QPushButton#danger:disabled {
    color: #71717b;
    border-color: #27272a;
}

QPushButton#accent,
QPushButton#accentCompact {
    background-color: #1f3d0a;
    color: #ecfccb;
    border: 1px solid #5ea500;
    border-radius: 8px;
    padding: 0 8px;
    font-weight: 600;
}

QPushButton#accent:hover,
QPushButton#accentCompact:hover {
    background-color: #5ea500;
    border-color: #7cc800;
    color: #ffffff;
}

QPushButton#accent:pressed,
QPushButton#accentCompact:pressed {
    background-color: #497d00;
    border-color: #497d00;
}

QPushButton#accent {
    font-size: 15px;
    min-width: 120px;
    max-width: 120px;
    min-height: 46px;
    max-height: 46px;
}

QPushButton#accentCompact {
    font-size: 14px;
    min-width: 100px;
    max-width: 100px;
    min-height: 40px;
    max-height: 40px;
}

QPushButton#ghostCompact {
    background-color: transparent;
    color: #9f9fa9;
    border: 1px solid #3f3f46;
    border-radius: 8px;
    padding: 0 8px;
    font-size: 14px;
    font-weight: 600;
    min-width: 100px;
    max-width: 100px;
    min-height: 40px;
    max-height: 40px;
}

QPushButton#ghostCompact:hover {
    background-color: #18181b;
    border-color: #52525c;
    color: #e4e4e7;
}

QPushButton#ghostCompact:disabled {
    color: #71717b;
    border-color: #27272a;
}

QPushButton#dangerCompact {
    background-color: transparent;
    color: #f87171;
    border: 1px solid #7f1d1d;
    border-radius: 8px;
    padding: 0 8px;
    font-size: 14px;
    font-weight: 600;
    min-width: 100px;
    max-width: 100px;
    min-height: 40px;
    max-height: 40px;
}

QPushButton#dangerCompact:hover {
    background-color: rgba(239, 68, 68, 0.12);
    border-color: #ef4444;
    color: #fca5a5;
}

QPushButton#dangerCompact:pressed {
    background-color: rgba(239, 68, 68, 0.2);
}

QPushButton#dangerCompact:disabled {
    color: #71717b;
    border-color: #27272a;
}

/* Map list card actions — layout sets width (1/3 each); no global 100px cap */
QPushButton#mapCardOpen,
QPushButton#mapCardGhost,
QPushButton#mapCardDanger {
    border-radius: 8px;
    padding: 0 8px;
    font-size: 13px;
    font-weight: 600;
    min-width: 0;
    max-width: 16777215px;
}

QPushButton#mapCardOpen {
    background-color: #1f3d0a;
    color: #ecfccb;
    border: 1px solid #5ea500;
}

QPushButton#mapCardOpen:hover {
    background-color: #5ea500;
    border-color: #7cc800;
    color: #ffffff;
}

QPushButton#mapCardOpen:pressed {
    background-color: #497d00;
    border-color: #497d00;
}

QPushButton#mapCardGhost {
    background-color: transparent;
    color: #9f9fa9;
    border: 1px solid #3f3f46;
}

QPushButton#mapCardGhost:hover {
    background-color: #18181b;
    border-color: #52525c;
    color: #e4e4e7;
}

QPushButton#mapCardDanger {
    background-color: transparent;
    color: #f87171;
    border: 1px solid #7f1d1d;
}

QPushButton#mapCardDanger:hover {
    background-color: rgba(239, 68, 68, 0.12);
    border-color: #ef4444;
    color: #fca5a5;
}

QPushButton#mapCardDanger:pressed {
    background-color: rgba(239, 68, 68, 0.2);
}

QLabel#panelTitle {
    color: #9f9fa9;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0.6px;
}

QPushButton#link {
    background-color: transparent;
    color: #7ccf00;
    font-size: 15px;
    font-weight: 600;
    border: none;
    padding: 2px 4px;
    text-align: center;
}

QPushButton#link:hover {
    color: #9ae600;
}

QPushButton#link:disabled {
    color: #71717b;
}

QFrame#divider {
    background-color: #3f3f46;
    max-height: 1px;
    min-height: 1px;
    border: none;
}
