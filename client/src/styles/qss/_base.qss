* {
    font-family: "Inter", "Segoe UI", "SF Pro Display", "Helvetica Neue", sans-serif;
}

QLabel {
    color: #e4e4e7;
    font-size: 16px;
    background-color: transparent;
}

QLabel#brand {
    color: #e4e4e7;
    font-size: 32px;
    font-weight: 700;
    letter-spacing: -0.5px;
}

QLabel#brandSmall {
    color: #e4e4e7;
    font-size: 21px;
    font-weight: 700;
    letter-spacing: -0.3px;
}

QLabel#title {
    color: #e4e4e7;
    font-size: 25px;
    font-weight: 600;
}

QLabel#subtitle {
    color: #9f9fa9;
    font-size: 15px;
    font-weight: 600;
}

QLabel#fieldLabel {
    color: #9f9fa9;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.6px;
}

QLabel#status {
    color: #9f9fa9;
    font-size: 14px;
    font-weight: 700;
    min-height: 18px;
}

QLabel[level="error"] {
    color: #e7000b;
}

QLabel[level="success"] {
    color: #497d00;
}

QLabel[level="info"] {
    color: #9f9fa9;
}

QLabel#userBadge {
    color: #9ae600;
    font-size: 14px;
    font-weight: 600;
    background-color: rgba(94, 165, 0, 0.14);
    border: 1px solid rgba(94, 165, 0, 0.38);
    border-radius: 8px;
    padding: 5px 14px;
}

/* Panels / cards: 1px #3f3f46, 12px radius */
QWidget#card,
QWidget#heroCard,
QFrame#mapCard {
    background-color: #18181b;
    border: 1px solid #3f3f46;
    border-radius: 12px;
}

QFrame#mapCard:hover {
    background-color: #1c1c20;
    border-color: #52525c;
}

QLineEdit {
    background-color: #27272a;
    color: #e4e4e7;
    border: 1px solid #3f3f46;
    border-radius: 8px;
    padding: 12px 16px;
    font-size: 15px;
    selection-background-color: #5ea500;
    selection-color: #FFFFFF;
}

QLineEdit:focus {
    border: 1px solid #5ea500;
    background-color: #27272a;
}

QLineEdit:disabled {
    color: #71717b;
    background-color: #18181b;
}

QPushButton {
    background-color: #5ea500;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 13px 22px;
    font-size: 15px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #497d00;
}

QPushButton:pressed {
    background-color: #3c6300;
}

QPushButton:disabled {
    background-color: #3f3f46;
    color: #9f9fa9;
}

QPushButton#ghost {
    background-color: transparent;
    color: #9f9fa9;
    border: 1px solid #3f3f46;
}

QPushButton#ghost:hover {
    background-color: #18181b;
    border-color: #52525c;
    color: #e4e4e7;
}

QPushButton#ghost:disabled {
    color: #71717b;
    border-color: #27272a;
}

QPushButton#primary {
    background-color: #5ea500;
    color: #ffffff;
    border: none;
    padding: 14px 28px;
    font-size: 17px;
}

QPushButton#primary:hover {
    background-color: #497d00;
}

QPushButton#primary:pressed {
    background-color: #3c6300;
}

QPushButton#primary:disabled {
    background-color: #3f3f46;
    color: #9f9fa9;
}

QPushButton#secondary {
    background-color: #18181b;
    color: #e4e4e7;
    border: 1px solid #3f3f46;
    padding: 14px 28px;
    font-size: 17px;
}

QPushButton#secondary:hover {
    background-color: #27272a;
    border-color: #71717b;
}

QPushButton#secondary:pressed {
    background-color: #09090b;
}

QPushButton#secondary:disabled {
    color: #71717b;
    border-color: #27272a;
    background-color: transparent;
}

QPushButton#danger {
    background-color: transparent;
    color: #f87171;
    border: 1px solid #7f1d1d;
    padding: 14px 28px;
    font-size: 17px;
}

QPushButton#danger:hover {
    background-color: rgba(239, 68, 68, 0.12);
    border-color: #ef4444;
    color: #fca5a5;
}

QPushButton#danger:pressed {
    background-color: rgba(239, 68, 68, 0.2);
}

QPushButton#danger:disabled {
    color: #71717b;
    border-color: #27272a;
}

QPushButton#link {
    background-color: transparent;
    color: #7ccf00;
    font-size: 15px;
    font-weight: 600;
    border: none;
    padding: 2px 4px;
    text-align: center;
}

QPushButton#link:hover {
    color: #9ae600;
}

QPushButton#link:disabled {
    color: #71717b;
}

QFrame#divider {
    background-color: #3f3f46;
    max-height: 1px;
    min-height: 1px;
    border: none;
}
