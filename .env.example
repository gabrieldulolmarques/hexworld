# UID/GID do host — evita que server/data/ fique owned by root no volume Docker
UID=1000
GID=1000

# Pyro Name Server (cliente RMI) — usado por `make up`
PYRO_NS_HOST=127.0.0.1
PYRO_NS_PORT=9090

# Callback do cliente para eventos em tempo real (servidor no Docker)
# Com vários clientes (`make up clients=2`), cada um usa base+id-1 (9092, 9093, …)
RMI_CALLBACK_BASE_PORT=9092
RMI_CALLBACK_NAT_HOST=host.docker.internal
