# Copie para .env e cole a chave do Playit.gg:
# https://playit.gg/account/setup/wizard/new-account/docker/docker-name
SECRET_KEY=

# UID/GID do host — evita que server/data/ fique owned by root no volume Docker
UID=1000
GID=1000

# Servidor público para demonstração (Playit.gg)
DEMO_SERVER_ADDRESS=hexworld.playit.plus:1048
